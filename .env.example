# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used by background jobs / server actions that need to bypass RLS
# (e.g. writing notification_log, audit_log, the WorkDrive polling cron). Never
# expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Zoho WorkDrive API (Phase 2) - Self Client, see MILESTONES.md for setup steps
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
# Team Folder new client folders get created under
ZOHO_CLIENTS_PARENT_FOLDER_ID=

# Shared secret Vercel Cron sends as a Bearer token when calling
# /api/cron/poll-workdrive - set the same value here and in Vercel's env vars
CRON_SECRET=

# Automated document verification (src/lib/verification.ts). Stays off until
# BOTH are set, so adding the key alone doesn't start spending.
# Key from platform.claude.com > API Keys.
ANTHROPIC_API_KEY=
DOCUMENT_VERIFICATION_ENABLED=false
# Files reviewed per daily run (each is one model call); the rest wait for the next run
VERIFICATION_MAX_FILES_PER_RUN=10
